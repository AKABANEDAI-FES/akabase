{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "panda codegen",
    "dev": "vite dev",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "oxlint --type-aware --type-check",
    "format": "oxfmt",
    "check": "concurrently 'oxlint --type-aware --type-check' 'oxfmt --check'",
    "check:fix": "concurrently 'oxlint --type-aware --type-check --fix' 'oxfmt --write'",
    "cf-typegen": "wrangler types",
    "migrate": "wrangler d1 migrations apply archive --local",
    "seed": "wrangler d1 execute archive --local --file=./scripts/seed.sql",
    "seed:large": "pnpm dlx tsx scripts/seed-large.ts",
    "deploy": "pnpm run build && wrangler deploy"
  },
  "dependencies": {
    "@archive/application": "workspace:*",
    "@archive/domain": "workspace:*",
    "@archive/infrastructure": "workspace:*",
    "@archive/result": "workspace:*",
    "@archive/styled-system": "workspace:*",
    "@archive/ui": "workspace:*",
    "@ark-ui/react": "catalog:frontend",
    "@cloudflare/vite-plugin": "catalog:build",
    "@dnd-kit/core": "catalog:frontend",
    "@dnd-kit/modifiers": "catalog:frontend",
    "@dnd-kit/sortable": "catalog:frontend",
    "@dnd-kit/utilities": "catalog:frontend",
    "@hono/standard-validator": "catalog:backend",
    "@tanstack/react-devtools": "catalog:frontend",
    "@tanstack/react-form": "catalog:frontend",
    "@tanstack/react-query": "catalog:frontend",
    "@tanstack/react-query-devtools": "catalog:frontend",
    "@tanstack/react-router": "catalog:frontend",
    "@tanstack/react-router-devtools": "catalog:frontend",
    "@tanstack/react-router-ssr-query": "catalog:frontend",
    "@tanstack/react-start": "catalog:frontend",
    "@tanstack/react-table": "catalog:frontend",
    "@tanstack/router-plugin": "catalog:build",
    "@tiptap/core": "catalog:frontend",
    "@tiptap/extension-image": "catalog:frontend",
    "@tiptap/extension-link": "catalog:frontend",
    "@tiptap/extension-text-align": "catalog:frontend",
    "@tiptap/extensions": "catalog:frontend",
    "@tiptap/pm": "catalog:frontend",
    "@tiptap/react": "catalog:frontend",
    "@tiptap/starter-kit": "catalog:frontend",
    "better-auth": "catalog:backend",
    "es-toolkit": "catalog:",
    "hono": "catalog:backend",
    "lucide-react": "catalog:frontend",
    "react": "catalog:frontend",
    "react-dom": "catalog:frontend",
    "react-reverse-portal": "catalog:frontend",
    "vite-tsconfig-paths": "catalog:build",
    "wasm-xlsxwriter": "catalog:frontend",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@archive/config": "workspace:*",
    "@cloudflare/vitest-pool-workers": "catalog:test",
    "@pandacss/dev": "catalog:build",
    "@tanstack/devtools-vite": "catalog:build",
    "@types/node": "catalog:types",
    "@types/react": "catalog:types",
    "@types/react-dom": "catalog:types",
    "@vitejs/plugin-react": "catalog:build",
    "babel-plugin-react-compiler": "catalog:build",
    "concurrently": "catalog:build",
    "drizzle-kit": "catalog:build",
    "oxlint": "catalog:lint",
    "oxlint-tsgolint": "catalog:lint",
    "typescript": "catalog:build",
    "vite": "catalog:build",
    "vitest": "catalog:test",
    "web-vitals": "catalog:frontend",
    "wrangler": "catalog:build"
  }
}
