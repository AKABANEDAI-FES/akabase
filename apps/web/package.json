{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "panda codegen",
    "dev": "vite dev",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "oxlint --type-aware --type-check",
    "format": "oxfmt",
    "check": "concurrently 'oxlint --type-aware --type-check' 'oxfmt --check'",
    "check:fix": "concurrently 'oxlint --type-aware --type-check --fix' 'oxfmt --write'",
    "cf-typegen": "wrangler types",
    "migrate": "wrangler d1 migrations apply archive --local",
    "seed": "wrangler d1 execute archive --local --file=./scripts/seed.sql",
    "seed:large": "pnpm dlx tsx scripts/seed-large.ts",
    "deploy": "pnpm run build && wrangler deploy"
  },
  "dependencies": {
    "@archive/application": "workspace:*",
    "@archive/domain": "workspace:*",
    "@archive/infrastructure": "workspace:*",
    "@archive/result": "workspace:*",
    "@archive/styled-system": "workspace:*",
    "@archive/ui": "workspace:*",
    "@ark-ui/react": "^5.32.0",
    "@cloudflare/vite-plugin": "^1.25.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hono/standard-validator": "^0.2.2",
    "@tanstack/react-devtools": "^0.9.6",
    "@tanstack/react-form": "^1.28.3",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@tanstack/react-router": "^1.161.4",
    "@tanstack/react-router-devtools": "^1.161.4",
    "@tanstack/react-router-ssr-query": "^1.161.4",
    "@tanstack/react-start": "^1.161.4",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/router-plugin": "^1.161.4",
    "@tiptap/core": "^3.20.0",
    "@tiptap/extension-image": "^3.20.0",
    "@tiptap/extension-link": "^3.20.0",
    "@tiptap/extension-text-align": "^3.20.0",
    "@tiptap/extensions": "^3.20.0",
    "@tiptap/pm": "^3.20.0",
    "@tiptap/react": "^3.20.0",
    "@tiptap/starter-kit": "^3.20.0",
    "better-auth": "^1.4.18",
    "es-toolkit": "^1.45.1",
    "hono": "^4.12.5",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-reverse-portal": "^2.3.0",
    "vite-tsconfig-paths": "^6.0.2",
    "wasm-xlsxwriter": "^0.12.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@archive/config": "workspace:*",
    "@cloudflare/vitest-pool-workers": "^0.12.18",
    "@pandacss/dev": "^1.9.0",
    "@tanstack/devtools-vite": "^0.5.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^9.2.1",
    "drizzle-kit": "0.31.9",
    "oxlint": "^1.49.0",
    "oxlint-tsgolint": "^0.16.0",
    "typescript": "^5.7.2",
    "vite": "^7.1.7",
    "vitest": "^4.0.18",
    "web-vitals": "^5.1.0",
    "wrangler": "^4.67.0"
  }
}
