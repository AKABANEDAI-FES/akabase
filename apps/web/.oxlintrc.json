{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./node_modules/@archive/config/oxlint/react.json"],
  "ignorePatterns": [
    "**/.nx/**",
    "**/.svelte-kit/**",
    "**/build/**",
    "**/coverage/**",
    "**/dist/**",
    "**/snap/**",
    "**/vite.config.*.timestamp-*.*",
    "postcss.config.cjs",
    "worker-configuration.d.ts",
    "routeTree.gen.ts"
  ],
  "overrides": [
    {
      "files": ["src/routes/**/*.{ts,tsx}"],
      "rules": {
        "unicorn/filename-case": "off"
      }
    }
  ]
}
