{
  "name": "akabase",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "pnpm -F @akabase/ui build:preset",
    "dev": "vpr -r --parallel dev",
    "build": "vpr -r build",
    "test": "vpr -r test",
    "lint": "vpr -r lint",
    "lint:fix": "vpr -r lint --fix",
    "check": "vp fmt --check && vpr -r lint",
    "check:fix": "vp fmt --write && vpr -r lint --fix",
    "format": "vp fmt --write"
  },
  "devDependencies": {
    "vite-plus": "catalog:build"
  },
  "packageManager": "pnpm@10.32.1"
}
