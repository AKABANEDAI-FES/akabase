{
  "name": "archive",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "panda codegen",
    "dev": "vite dev",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "oxlint",
    "format": "oxfmt",
    "check": "concurrently 'oxlint' 'oxfmt --check'",
    "check:fix": "concurrently 'oxlint --fix' 'oxfmt --write'",
    "cf-typegen": "wrangler types",
    "migration": "drizzle-kit generate",
    "migrate": "wrangler d1 migrations apply archive --local",
    "seed": "wrangler d1 execute archive --local --file=./scripts/seed.sql",
    "seed:large": "npx tsx scripts/seed-large.ts"
  },
  "dependencies": {
    "@ark-ui/react": "^5.32.0",
    "@cloudflare/vite-plugin": "^1.25.2",
    "@praha/byethrow": "^0.10.0",
    "@tanstack/react-devtools": "^0.9.6",
    "@tanstack/react-form": "^1.28.3",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@tanstack/react-router": "^1.161.4",
    "@tanstack/react-router-devtools": "^1.161.4",
    "@tanstack/react-router-ssr-query": "^1.161.4",
    "@tanstack/react-start": "^1.161.4",
    "@tanstack/router-plugin": "^1.161.4",
    "better-auth": "^1.4.18",
    "drizzle-orm": "0.45.1",
    "drizzle-zod": "^0.8.3",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite-tsconfig-paths": "^6.0.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@libsql/client": "^0.17.0",
    "@pandacss/dev": "^1.8.1",
    "@stylistic/eslint-plugin": "^5.8.0",
    "@tanstack/devtools-vite": "^0.5.1",
    "@tanstack/eslint-config": "^0.4.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^9.2.1",
    "drizzle-kit": "0.31.9",
    "jsdom": "^28.1.0",
    "oxfmt": "^0.34.0",
    "oxlint": "^1.49.0",
    "typescript": "^5.7.2",
    "vite": "^7.1.7",
    "vitest": "^4.0.18",
    "web-vitals": "^5.1.0",
    "wrangler": "^4.67.0"
  },
  "pnpm": {
    "overrides": {
      "vite": "8.0.0-beta.11"
    }
  }
}
