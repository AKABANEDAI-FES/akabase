{
  "name": "archive",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "pnpm -F @archive/ui build:preset",
    "dev": "vp run -r dev",
    "build": "vp run -r build",
    "test": "vp run -r test",
    "lint": "vp run -r lint",
    "lint:fix": "vp run -r lint -- --fix",
    "check": "vp fmt --check && vp run -r lint",
    "check:fix": "vp fmt --write && vp run -r lint -- --fix",
    "format": "vp fmt --write"
  },
  "devDependencies": {
    "vite-plus": "catalog:build"
  },
  "packageManager": "pnpm@10.32.1"
}
