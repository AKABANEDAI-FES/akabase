{
  "name": "@akabase/domain",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "exports": {
    "./api-key/*": {
      "import": "./dist/api-key/*.mjs",
      "types": "./dist/api-key/*.d.mts"
    },
    "./authorization/*": {
      "import": "./dist/authorization/*.mjs",
      "types": "./dist/authorization/*.d.mts"
    },
    "./event/*": {
      "import": "./dist/event/*.mjs",
      "types": "./dist/event/*.d.mts"
    },
    "./organization/*": {
      "import": "./dist/organization/*.mjs",
      "types": "./dist/organization/*.d.mts"
    },
    "./project/*": {
      "import": "./dist/project/*.mjs",
      "types": "./dist/project/*.d.mts"
    },
    "./shared/*": {
      "import": "./dist/shared/*.mjs",
      "types": "./dist/shared/*.d.mts"
    },
    "./user/*": {
      "import": "./dist/user/*.mjs",
      "types": "./dist/user/*.d.mts"
    }
  },
  "scripts": {
    "lint": "vp lint",
    "build": "vp pack",
    "dev": "vp pack --no-clean --watch",
    "test": "vp test run"
  },
  "dependencies": {
    "@akabase/result": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@akabase/config": "workspace:*",
    "@typescript/native-preview": "catalog:build",
    "typescript": "catalog:build",
    "vite-plus": "catalog:build"
  }
}
