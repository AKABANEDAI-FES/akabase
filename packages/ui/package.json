{
  "name": "@archive/ui",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "exports": {
    "./panda-preset": {
      "import": "./dist/panda-preset.mjs",
      "types": "./dist/panda-preset.d.mts"
    },
    "./components/*": {
      "import": "./dist/components/*/index.mjs",
      "types": "./dist/components/*/index.d.mts"
    }
  },
  "scripts": {
    "lint": "vp lint",
    "build": "vp pack",
    "build:preset": "vp pack --no-clean src/panda-preset.ts",
    "dev": "vp pack --no-clean --watch"
  },
  "devDependencies": {
    "@archive/config": "workspace:*",
    "@pandacss/dev": "catalog:build",
    "@pandacss/types": "catalog:build",
    "@types/react": "catalog:types",
    "typescript": "catalog:build",
    "vite-plus": "catalog:build"
  },
  "peerDependencies": {
    "@archive/styled-system": "workspace:*",
    "@ark-ui/react": "^5",
    "lucide-react": "^0",
    "react": "^19",
    "react-dom": "^19"
  }
}
