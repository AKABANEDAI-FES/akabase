{
  "name": "@archive/ui",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "exports": {
    "./panda-preset": {
      "import": "./dist/panda-preset.mjs",
      "types": "./dist/panda-preset.d.mts"
    },
    "./components/*": {
      "import": "./dist/components/*/index.mjs",
      "types": "./dist/components/*/index.d.mts"
    }
  },
  "scripts": {
    "lint": "oxlint --type-aware --type-check",
    "build": "tsdown",
    "dev": "tsdown --watch"
  },
  "devDependencies": {
    "@archive/config": "workspace:*",
    "@pandacss/dev": "^1.9.0",
    "oxlint": "^1.49.0",
    "oxlint-tsgolint": "^0.16.0",
    "tsdown": "^0.21.1",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@ark-ui/react": "^5.32.0"
  },
  "peerDependencies": {
    "@archive/styled-system": "workspace:*"
  }
}
