{
  "name": "@archive/infrastructure",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "exports": {
    "./auth": {
      "import": "./dist/auth/index.mjs",
      "types": "./dist/auth/index.d.mts"
    },
    "./db": {
      "import": "./dist/db/index.mjs",
      "types": "./dist/db/index.d.mts"
    },
    "./repositories/*": {
      "import": "./dist/repositories/*.mjs",
      "types": "./dist/repositories/*.d.mts"
    },
    "./services/*": {
      "import": "./dist/services/*.mjs",
      "types": "./dist/services/*.d.mts"
    },
    "./storage/*": {
      "import": "./dist/storage/*.mjs",
      "types": "./dist/storage/*.d.mts"
    }
  },
  "scripts": {
    "lint": "vp lint",
    "build": "vp pack",
    "dev": "vp pack --no-clean --watch",
    "cf-typegen": "wrangler types --include-env false",
    "migration": "drizzle-kit generate"
  },
  "dependencies": {
    "@archive/result": "workspace:*",
    "@archive/domain": "workspace:*",
    "better-auth": "catalog:backend",
    "drizzle-orm": "catalog:backend",
    "drizzle-zod": "catalog:backend",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@archive/config": "workspace:*",
    "@types/node": "catalog:types",
    "@typescript/native-preview": "catalog:build",
    "drizzle-kit": "catalog:build",
    "typescript": "catalog:build",
    "vite-plus": "catalog:build",
    "wrangler": "catalog:build"
  }
}
