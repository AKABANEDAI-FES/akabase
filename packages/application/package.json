{
  "name": "@archive/application",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "exports": {
    "./command/event/*": {
      "import": "./dist/command/event/*.mjs",
      "types": "./dist/command/event/*.d.mts"
    },
    "./command/organization/*": {
      "import": "./dist/command/organization/*.mjs",
      "types": "./dist/command/organization/*.d.mts"
    },
    "./command/project/*": {
      "import": "./dist/command/project/*.mjs",
      "types": "./dist/command/project/*.d.mts"
    },
    "./command/shared/*": {
      "import": "./dist/command/shared/*.mjs",
      "types": "./dist/command/shared/*.d.mts"
    },
    "./command/user/*": {
      "import": "./dist/command/user/*.mjs",
      "types": "./dist/command/user/*.d.mts"
    },
    "./query/authorization/*": {
      "import": "./dist/query/authorization/*.mjs",
      "types": "./dist/query/authorization/*.d.mts"
    },
    "./query/event/*": {
      "import": "./dist/query/event/*.mjs",
      "types": "./dist/query/event/*.d.mts"
    },
    "./query/organization/*": {
      "import": "./dist/query/organization/*.mjs",
      "types": "./dist/query/organization/*.d.mts"
    },
    "./query/project/*": {
      "import": "./dist/query/project/*.mjs",
      "types": "./dist/query/project/*.d.mts"
    },
    "./query/user/*": {
      "import": "./dist/query/user/*.mjs",
      "types": "./dist/query/user/*.d.mts"
    },
    "./query/shared": {
      "import": "./dist/query/shared.mjs",
      "types": "./dist/query/shared.d.mts"
    }
  },
  "scripts": {
    "lint": "oxlint --type-aware --type-check",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@archive/domain": "workspace:*",
    "@archive/infrastructure": "workspace:*",
    "@archive/result": "workspace:*",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@archive/config": "workspace:*",
    "@libsql/client": "^0.17.0",
    "@typescript/native-preview": "7.0.0-dev.20260310.1",
    "oxlint": "^1.49.0",
    "oxlint-tsgolint": "^0.16.0",
    "tsdown": "^0.21.1",
    "typescript": "^5.7.2",
    "vitest": "^4.0.18"
  }
}
